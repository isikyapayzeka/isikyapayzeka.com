---
import Base from "../layouts/Base.astro";
import { METIN, type Dil } from "../i18n";
import { ayarlar, epostaHref, etkinlikler, ortaklar } from "../veri";

interface Props { dil: Dil }
const { dil } = Astro.props;
const M = METIN[dil];
const A = await ayarlar();
const simdi = Date.now();
const gecmis = (await etkinlikler(dil)).filter((e) => e.bitis.getTime() < simdi);
const konuklar = gecmis.flatMap((e) => e.konuklar.map((k) => ({ k, etkinlik: e.baslik, gun: e.gunKisa, yil: e.baslangic.getFullYear() })));
const O = await ortaklar(dil);
---
<Base dil={dil} sayfa="sirketler" baslik={M.sirketBaslik}>
  <section class="bolum kap giris">
    <p class="etiket">{M.ust.toLocaleUpperCase(dil)}</p>
    <h1>{M.sirketBaslik}</h1>
    <p class="ikincil uzun">{M.sirketGiris}</p>
    {A.eposta && (
      <div class="satir">
        <a class="btn btn--ana" href={epostaHref(A.eposta, M.sirketKonu)} data-kopya={A.eposta}>{M.sirketCta}</a>
        <span class="adres">{A.eposta}</span>
      </div>
    )}
  </section>

  <section class="bolum kap">
    <ul class="yollar">
      {M.sirketYollar.map((y) => (
        <li><h2 class="yol-baslik">{y.baslik}</h2><p class="ikincil">{y.metin}</p></li>
      ))}
    </ul>
  </section>

  {konuklar.length > 0 && (
    <section class="bolum kap" aria-labelledby="bugune">
      <div class="bolum-bas"><h2 id="bugune">{M.sirketBugune}</h2></div>
      <ul class="konuklar">
        {konuklar.map((x) => (
          <li><span class="etiket">{`${x.gun} ${x.yil}`}</span><span class="konuk-ad">{x.k}</span><span class="ikincil">{x.etkinlik}</span></li>
        ))}
      </ul>
      {O.length > 0 && (
        <p class="ortak-satir ikincil">{M.ortak}: {O.map((o) => o.ad).join(" · ")}</p>
      )}
    </section>
  )}
</Base>

<style>
  .giris { display: grid; gap: 18px; }
  h1 { font-size: clamp(34px, 6vw, 56px); line-height: 1.05; font-weight: 700; letter-spacing: -0.02em; max-width: 18ch; }
  .uzun { max-width: 58ch; font-size: 18px; }
  .satir { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; }
  .adres { font: 500 14px/1.4 var(--f-mono); color: var(--ikincil); user-select: all; }

  .yollar { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .yollar li { display: grid; gap: 8px; padding: 22px; border-radius: 16px; background: var(--yuzey); border: 1px solid var(--cizgi); }
  .yol-baslik { font-size: 20px; }
  @media (min-width: 820px) { .yollar { grid-template-columns: repeat(3, 1fr); } }

  .konuklar { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--cizgi); }
  .konuklar li { display: grid; gap: 4px; padding-block: 16px; border-bottom: 1px solid var(--cizgi); }
  .konuk-ad { font-weight: 600; font-size: 18px; }
  @media (min-width: 820px) { .konuklar li { grid-template-columns: 140px 1fr 1fr; gap: 20px; align-items: baseline; } }
  .ortak-satir { margin-top: 20px; }
</style>
