---
// Geçmiş etkinlik satırı: solda tarih ve tür, sağda başlık, özet, konuk ve ortaklar.
import { METIN, type Dil } from "../i18n";
import type { Etkinlik } from "../veri";

interface Props { e: Etkinlik; dil: Dil; bekliyor?: boolean }
const { e, dil, bekliyor = false } = Astro.props;
const M = METIN[dil];
const ayrintilar = [
  e.konuklar.length ? `${M.konuk}: ${e.konuklar.join(", ")}` : "",
  e.ortaklar.length ? `${M.ortak}: ${e.ortaklar.join(", ")}` : "",
].filter(Boolean);
---
<li class="satir-e" data-bitis={e.bitisIso} data-gecmis-bekliyor={bekliyor ? "" : undefined} hidden={bekliyor}>
  <div class="satir-sol">
    <time datetime={e.iso}>{`${e.gunKisa} ${e.baslangic.getFullYear()}`}</time>
    <span>{e.tur}</span>
  </div>
  <div class="satir-sag">
    <h3>{e.link ? <a href={e.link}>{e.baslik}</a> : e.baslik}</h3>
    {e.ozet && <p class="ikincil">{e.ozet}</p>}
    {ayrintilar.length > 0 && <p class="satir-ayrinti">{ayrintilar.join(" · ")}</p>}
  </div>
</li>

<style>
  .satir-e { display: grid; grid-template-columns: 1fr; gap: 6px; padding-block: 20px; border-bottom: 1px solid var(--cizgi); }
  .satir-sol { display: flex; gap: 12px; align-items: baseline; font: 500 12.5px/1.5 var(--f-mono); letter-spacing: 0.04em; }
  .satir-sol time { color: var(--ikincil); font-variant-numeric: tabular-nums; }
  .satir-sol span { color: var(--soluk); }
  .satir-sag { display: grid; gap: 6px; min-width: 0; }
  .satir-sag h3 a { text-decoration: none; }
  .satir-sag h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .satir-ayrinti { font-size: 14px; color: var(--soluk); }
  @media (min-width: 760px) {
    .satir-e { grid-template-columns: 170px 1fr; gap: 24px; }
    .satir-sol { flex-direction: column; gap: 2px; }
  }
</style>
