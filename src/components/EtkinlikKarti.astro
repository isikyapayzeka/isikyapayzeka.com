---
// Fotoğraflı etkinlik kartı. Görseli olmayan etkinlikte lacivert bir yer tutucu gösterilir.
import { METIN, type Dil } from "../i18n";
import type { Etkinlik } from "../veri";
import TakvimMenusu from "./TakvimMenusu.astro";

interface Props {
  e: Etkinlik;
  dil: Dil;
  // "yaklasan": tarihi geçince tarayıcıda gizlenir. "gecmis-bekliyor": build anında gelecekte, tarihi geçince görünür.
  durum?: "yaklasan" | "gecmis" | "gecmis-bekliyor";
}
const { e, dil, durum = "gecmis" } = Astro.props;
const M = METIN[dil];
const yaklasan = durum === "yaklasan";
const g = e.gorsel ? `/etkinlikler/${e.gorsel}` : "";
const altBilgi = [
  e.ortaklar.length ? `${M.ortak}: ${e.ortaklar.join(", ")}` : "",
  yaklasan ? [e.yer, e.saat].filter(Boolean).join(" · ") : "",
].filter(Boolean);
---
<li
  class:list={["kart", { "kart--yaklasan": yaklasan, "kart--yan": yaklasan && e.afis }]}
  data-bitis={e.bitisIso}
  data-yaklasan={yaklasan ? "" : undefined}
  data-gecmis-bekliyor={durum === "gecmis-bekliyor" ? "" : undefined}
  hidden={durum === "gecmis-bekliyor"}
>
  <div class:list={["kart-gorsel", { "kart-gorsel--afis": e.afis }]}>
    {g && e.afis && e.afisBoyut && <img src={`${g}.jpg`} alt={e.gorselAlt} width={e.afisBoyut.en} height={e.afisBoyut.boy} loading="lazy" decoding="async" />}
    {g && !e.afis && (
      <img
        src={`${g}-800.jpg`}
        srcset={`${g}-800.jpg 800w, ${g}-1600.jpg 1600w`}
        sizes="(min-width: 1040px) 360px, (min-width: 720px) 50vw, 100vw"
        alt={e.gorselAlt}
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
      />
    )}
    {!g && <img class="kart-logo" src="/img/kulup-logo-mavi.png" alt="" width="96" height="96" loading="lazy" />}
  </div>
  <div class="kart-govde">
    <p class="kart-ust">
      <time datetime={e.iso}>{yaklasan ? `${e.gun} · ${e.haftaGunu}` : e.gun}</time>
      <span>{e.tur}</span>
    </p>
    <h3><a href={e.sayfa}>{e.baslik}</a></h3>
    {e.ozet && <p class="kart-ozet">{e.ozet}</p>}
    {e.konuklar.length > 0 && <p class="kart-konuk">{e.konuklar.join(", ")}</p>}
    {altBilgi.length > 0 && <p class="kart-alt-bilgi">{altBilgi.join(" · ")}</p>}
    {yaklasan && (
      <div class="kart-eylem">
        {e.kayitLinki && <a class="btn btn--ana" href={e.kayitLinki}>{M.kayitOl}</a>}
        <TakvimMenusu e={e} dil={dil} />
      </div>
    )}
  </div>
</li>
