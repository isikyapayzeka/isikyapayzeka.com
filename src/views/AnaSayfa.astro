---
import Base from "../layouts/Base.astro";
import EtkinlikKarti from "../components/EtkinlikKarti.astro";
import KulupAgi from "../components/KulupAgi.astro";
import { METIN, yol, type Dil } from "../i18n";
import { ayarlar, etkinlikler, ortaklar } from "../veri";

interface Props { dil: Dil }
const { dil } = Astro.props;
const M = METIN[dil];
const A = await ayarlar();
const tumu = await etkinlikler(dil);
const simdi = Date.now();
const yaklasan = tumu.filter((e) => e.bitis.getTime() >= simdi).reverse();
const gecmis = tumu.filter((e) => e.bitis.getTime() < simdi);
const O = await ortaklar(dil);
---
<Base dil={dil} sayfa="anasayfa">
  <section class="hero kap">
    <p class="etiket">{M.ust.toLocaleUpperCase(dil)}</p>
    <h1>{M.kulup}</h1>
    <p class="hero-vizyon">{dil === "en" ? A.vizyonEn : A.vizyon}</p>
    <div class="satir">
      {A.uyeFormu && <a class="btn btn--ana" href={A.uyeFormu}>{M.uyeOl}</a>}
      <a class="btn" href={yol("sirketler", dil)}>{M.sirketlerIcin}</a>
    </div>
  </section>

  {yaklasan.length > 0 && (
    <section class="kap siradaki" aria-labelledby="siradaki">
      <p class="etiket" id="siradaki">{M.siradaki.toLocaleUpperCase(dil)}</p>
      <ul class="kartlar" id="yaklasan-liste">
        {yaklasan.slice(0, 2).map((e) => <EtkinlikKarti e={e} dil={dil} durum="yaklasan" />)}
      </ul>
    </section>
  )}
  <div class="kap">
    <p class="serit" data-bos-ise-goster="yaklasan-liste" hidden={yaklasan.length > 0}>
      <span class="serit-nokta" aria-hidden="true"></span>
      <span>{M.siradakiYok}</span>
      {A.whatsapp && <a class="metin-link" href={A.whatsapp}>{M.whatsapp} →</a>}
    </p>
  </div>

  <section class="bolum kap" aria-label={dil === "en" ? "The club's network" : "Kulübün ağı"}>
    <KulupAgi dil={dil} etkinlikler={gecmis} ortaklar={O} />
    <p class="ag-alt"><a class="metin-link" href={yol("etkinlikler", dil)}>{M.tumEtkinlikler} →</a></p>
  </section>

  <section class="bolum kap katil" aria-labelledby="kimler">
    <div>
      <h2 id="kimler">{M.kimler}</h2>
      <p class="ikincil katil-metin">{M.kimlerMetin}</p>
    </div>
    <div class="satir">
      {A.uyeFormu && <a class="btn btn--ana" href={A.uyeFormu}>{M.uyeOl}</a>}
      {A.ekipBasvuru && <a class="btn" href={A.ekipBasvuru}>{M.ekibeKatil}</a>}
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 64px 36px; display: grid; gap: 22px; }
  .hero h1 { font-size: clamp(40px, 8.4vw, 88px); line-height: 0.98; font-weight: 700; letter-spacing: -0.03em; max-width: 13ch; }
  .hero-vizyon { font-size: clamp(19px, 2.4vw, 24px); line-height: 1.45; color: var(--ikincil); max-width: 36ch; }
  .satir { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (min-width: 820px) { .hero { padding-block: 112px 48px; } }

  .siradaki { display: grid; gap: 14px; padding-block: 8px 24px; }

  .serit { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; padding: 14px 0; border-block: 1px solid var(--cizgi); color: var(--ikincil); font-size: 15px; }
  .serit-nokta { width: 8px; height: 8px; border-radius: 50%; background: #3DDC97; box-shadow: 0 0 0 4px rgba(61, 220, 151, 0.16); }

  .ag-alt { margin-top: 20px; }

  .katil { display: grid; gap: 20px; border-top: 1px solid var(--cizgi); }
  .katil-metin { max-width: 52ch; margin-top: 10px; font-size: 17px; }
  @media (min-width: 820px) { .katil { grid-template-columns: 1fr auto; align-items: end; } }
</style>
