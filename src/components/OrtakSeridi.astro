---
// Birlikte etkinlik yapılan kulüp ve kurumlar: logo (yoksa adı) ve varsa linki.
// Yalnızca en az bir etkinlikte adı geçenler gösterilir.
import { getCollection } from "astro:content";
import { METIN, type Dil } from "../i18n";
import { ortaklar } from "../veri";

interface Props { dil: Dil; baslikGoster?: boolean }
const { dil, baslikGoster = true } = Astro.props;
const M = METIN[dil];
const kullanilan = new Set((await getCollection("etkinlikler")).flatMap((e) => e.data.ortaklar));
const liste = (await ortaklar(dil)).filter((o) => kullanilan.has(o.id));
---
{liste.length > 0 && (
  <div class="seritler">
    {baslikGoster && <h2 class="serit-baslik">{M.birlikte}</h2>}
    <ul class="ortaklar">
      {liste.map((o) => {
        const ic = (
          <>
            {o.logo
              ? <img src={`/img/ortaklar/${o.logo}`} alt="" width="64" height="64" loading="lazy" />
              : <span class="harf" aria-hidden="true">{o.ad}</span>}
            <span class="ad">{o.ad}</span>
          </>
        );
        return <li>{o.link ? <a href={o.link}>{ic}</a> : <div>{ic}</div>}</li>;
      })}
    </ul>
  </div>
)}

<style>
  .seritler { display: grid; gap: 20px; }
  .ortaklar { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .ortaklar a, .ortaklar div { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 18px 12px; height: 100%; border-radius: 14px; background: var(--kart); box-shadow: var(--golge); text-decoration: none; text-align: center; transition: box-shadow 150ms ease-out; }
  .ortaklar a:hover { box-shadow: var(--golge-hover); }
  .ortaklar img, .harf { width: 64px; height: 64px; border-radius: 14px; object-fit: cover; flex: none; }
  .harf { display: grid; place-items: center; background: var(--zemin-2); font: 600 13px/1.1 var(--f-baslik); color: var(--yazi); padding: 4px; overflow: hidden; }
  .ad { font-size: 14px; font-weight: 500; line-height: 1.35; }
</style>
