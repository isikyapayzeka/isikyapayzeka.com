---
// Yazı tipleri siteyle birlikte sunulur (Google Fonts'a ayrı bağlantı açılmaz, sayfa daha hızlı çizilir).
// latin-ext, Türkçe harfler (ğ, ş, ı, İ) içindir.
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-ext-400.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-ext-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/poppins/latin-ext-600.css";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-grotesk/latin-ext-500.css";
import "@fontsource/space-grotesk/latin-600.css";
import "@fontsource/space-grotesk/latin-ext-600.css";
import { jsonLd, kulupSemasi, sayfaSemasi, siteSemasi } from "../seo";
import { sayfaTarihi } from "../tazelik";
import { METIN, YOLLAR, yol, type Dil, type Sayfa } from "../i18n";
import { ayarlar, epostaHref } from "../veri";

interface Props {
  dil: Dil;
  sayfa: Sayfa;
  baslik?: string;
  aciklama?: string;
  gorselAlt?: string; // paylaşım görselinin metin karşılığı
  sema?: Record<string, unknown>[]; // sayfaya özel yapısal veri (src/seo.ts)
  dizinleme?: boolean; // false ise arama motorları sayfayı listelemez (404 sayfası)
  // Etkinlik sayfası gibi YOLLAR dışındaki sayfalar için iki dildeki adres.
  alternatif?: { tr: string; en: string };
  gorsel?: string; // paylaşım önizlemesi (og:image) için site köküne göre yol
  degisiklik?: string; // içeriğin son değiştiği an (ISO 8601). Verilmezse sayfanın kendi kaynaklarından bulunur.
}
const { dil, sayfa, baslik, aciklama, alternatif, gorsel } = Astro.props;
const adres = (d: Dil) => (alternatif ? alternatif[d] : yol(sayfa, d));
const M = METIN[dil];
const A = await ayarlar();
const digerDil: Dil = dil === "tr" ? "en" : "tr";
const { gorselAlt, sema = [], dizinleme = true } = Astro.props;
const sayfaBasligi = baslik ? `${baslik} · ${M.kulup}` : M.anaBaslik;
const sayfaAciklamasi = aciklama ?? M.aciklamalar[sayfa];
const kanonik = new URL(adres(dil), Astro.site).href;
// Paylaşım görseli: sayfa kendi görselini vermezse ana sayfanın kapak fotoğrafı kullanılır.
const kapak = A.kapak ? `/etkinlikler/${A.kapak}-1600.jpg` : "/img/kulup-logo.png";
const paylasimGorseli = new URL(gorsel ?? kapak, Astro.site).href;
const paylasimGorselAlt = gorsel ? gorselAlt : dil === "en" ? A.kapakAltEn : A.kapakAlt;
// Son değişiklik tarihi git geçmişinden gelir; okunamazsa alt bilgide yayın günü gösterilir, yapısal veriye tarih yazılmaz.
const degisiklik = Astro.props.degisiklik ?? sayfaTarihi(sayfa);
const yapisalVeri = jsonLd([
  kulupSemasi(dil, A, Astro.site!),
  siteSemasi(dil, Astro.site!),
  ...(dizinleme ? [sayfaSemasi({ url: kanonik, ad: sayfaBasligi, aciklama: sayfaAciklamasi, dil, degisiklik }, Astro.site!)] : []),
  ...sema,
]);
const guncelleme = new Intl.DateTimeFormat(M.yerel, { timeZone: "Europe/Istanbul", day: "numeric", month: "long", year: "numeric" }).format(degisiklik ? new Date(degisiklik) : new Date());
const menu = (Object.keys(YOLLAR) as Sayfa[]).map((s) => ({ s, href: yol(s, dil), ad: M.menu[s] }));
---
<!doctype html>
<html lang={dil}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{sayfaBasligi}</title>
  <meta name="description" content={sayfaAciklamasi} />
  <meta name="msvalidate.01" content="E5D866762DF6ABA7F13BBF0BFB30DC4F" />
  <meta name="robots" content={dizinleme ? "index, follow, max-image-preview:large, max-snippet:-1" : "noindex"} />
  {dizinleme && <link rel="canonical" href={kanonik} />}
  {dizinleme && <link rel="alternate" hreflang="tr" href={new URL(adres("tr"), Astro.site).href} />}
  {dizinleme && <link rel="alternate" hreflang="en" href={new URL(adres("en"), Astro.site).href} />}
  {dizinleme && <link rel="alternate" hreflang="x-default" href={new URL(adres("tr"), Astro.site).href} />}
  <meta property="og:site_name" content={M.kulup} />
  <meta property="og:locale" content={dil === "en" ? "en_GB" : "tr_TR"} />
  <meta property="og:locale:alternate" content={dil === "en" ? "tr_TR" : "en_GB"} />
  <meta property="og:title" content={sayfaBasligi} />
  <meta property="og:description" content={sayfaAciklamasi} />
  <meta property="og:url" content={kanonik} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={paylasimGorseli} />
  {paylasimGorselAlt && <meta property="og:image:alt" content={paylasimGorselAlt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={sayfaBasligi} />
  <meta name="twitter:description" content={sayfaAciklamasi} />
  <meta name="twitter:image" content={paylasimGorseli} />
  <script type="application/ld+json" set:html={yapisalVeri} />
  <meta name="theme-color" content="#0A118E" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
  <a class="atla" href="#icerik">{dil === "en" ? "Skip to content" : "İçeriğe geç"}</a>

  <header class="ust-bar">
    <div class="kap ust-ic">
      <a class="marka" href={yol("anasayfa", dil)} aria-label={M.kulup}>
        <img src="/img/kulup-logo-mavi.png" alt="" width="40" height="40" />
        <span>{M.kulupKisa}</span>
      </a>
      <nav class="menu" aria-label={M.menuAc}>
        <details class="menu-mobil">
          <summary aria-label={M.menuAc}><span></span><span></span></summary>
          <ul>
            {menu.map((m) => <li><a href={m.href} aria-current={m.s === sayfa ? "page" : undefined}>{m.ad}</a></li>)}
          </ul>
        </details>
        <ul class="menu-genis">
          {menu.filter((m) => m.s !== "anasayfa").map((m) => <li><a href={m.href} aria-current={m.s === sayfa ? "page" : undefined}>{m.ad}</a></li>)}
        </ul>
      </nav>
      <a class="dil" href={adres(digerDil)} hreflang={digerDil} lang={digerDil}>{M.digerDil}</a>
    </div>
  </header>

  <main id="icerik">
    <slot />
  </main>

  <footer class="dip">
    <div class="kap dip-ic">
      <div class="dip-marka">
        <div class="rozetler">
          <img src="/img/isik-logo.png" alt={dil === "en" ? "Işık University logo" : "Işık Üniversitesi logosu"} width="44" height="44" />
          <img src="/img/kulup-logo-mavi.png" alt="" width="44" height="44" />
        </div>
        <p class="dip-ad">{M.kulup}</p>
        <p class="etiket">{(dil === "en" ? "Şile Campus" : "Şile Kampüsü").toLocaleUpperCase(dil)} · {A.donem}</p>
      </div>
      <ul class="dip-linkler">
        {A.instagram && <li><a href={A.instagram} aria-label="Instagram" title="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg></a></li>}
        {A.linkedin && <li><a href={A.linkedin} aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="6.3" cy="6.2" r="1.95"/><rect x="4.7" y="9.2" width="3.2" height="10.3" rx="0.4"/><path d="M10.4 9.2h3.1v1.4c.45-.85 1.55-1.65 3.2-1.65 3.35 0 3.95 2.2 3.95 5.05v5.5h-3.2v-4.9c0-1.15-.05-2.6-1.6-2.6-1.6 0-1.85 1.25-1.85 2.5v5h-3.2z"/></svg></a></li>}
        {A.whatsapp && <li><a href={A.whatsapp} aria-label={M.whatsapp} title={M.whatsapp}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><g transform="translate(6.6 6.3) scale(0.45)"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" fill="currentColor" stroke="none"/></g></svg></a></li>}
        {A.eposta && <li><a href={epostaHref(A.eposta)} data-kopya={A.eposta} aria-label={A.eposta} title={A.eposta}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.8 6.6 7 5.3a2 2 0 0 0 2.4 0l7-5.3"/></svg></a></li>}
        <li><a href="/link/" aria-label={M.linkSayfasi} title={M.linkSayfasi}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></a></li>
      </ul>
      <p class="dip-alt">
        {M.sonGuncelleme}: {guncelleme} ·
        <a href="https://github.com/isikyapayzeka/isikyapayzeka.com/issues/new">{M.hataBildir}</a>
      </p>
    </div>
  </footer>

  <div class="bildirim" role="status" aria-live="polite"></div>

  <script is:inline define:vars={{ kopyalandiMetni: M.kopyalandi }}>
    // E-posta linkleri: e-posta uygulaması açılmasa bile adres panoya kopyalanır.
    const bildirim = document.querySelector(".bildirim");
    let zaman;
    document.addEventListener("click", (e) => {
      const a = e.target.closest("[data-kopya]");
      if (!a) return;
      const adres = a.getAttribute("data-kopya");
      const goster = (m) => {
        bildirim.textContent = m;
        bildirim.classList.add("acik");
        clearTimeout(zaman);
        zaman = setTimeout(() => bildirim.classList.remove("acik"), 3200);
      };
      if (navigator.clipboard?.writeText) navigator.clipboard.writeText(adres).then(() => goster(`${adres} · ${kopyalandiMetni}`), () => goster(adres));
      else goster(adres);
    });

    // Etkinlikler build sırasında ayrılır; site yeniden derlenmeden tarihi geçen etkinlik
    // "yaklaşan" listesinden kalkar, "geçmiş" listesinde görünür.
    const simdi = Date.now();
    document.querySelectorAll("[data-bitis]").forEach((el) => {
      const gecti = Date.parse(el.getAttribute("data-bitis")) < simdi;
      if (el.hasAttribute("data-yaklasan") && gecti) el.hidden = true;
      if (el.hasAttribute("data-gecmis-bekliyor") && gecti) el.hidden = false;
    });
    document.querySelectorAll("[data-bos-ise-goster]").forEach((el) => {
      const liste = document.getElementById(el.getAttribute("data-bos-ise-goster"));
      if (liste && !liste.querySelector("[data-bitis]:not([hidden])")) el.hidden = false;
    });
  </script>

</body>
</html>

<style is:global>
  /* Işık Üniversitesi sitesinin renkleri (isikun.edu.tr): lacivert #0A118E ana renk,
     açık gri zemin, beyaz kartlar, turuncu #FF8717 vurgu (sitedeki "Aday Öğrenci" butonu). */
  :root {
    --zemin: #F4F4F4;
    --zemin-2: #ECECEC;
    --kart: #FFFFFF;
    --yuzey: #FFFFFF;
    --yuzey-hover: #ECECEC;
    --cizgi: rgba(33, 37, 41, 0.10);
    --yazi: #212529;
    --ikincil: #495057;
    --soluk: #6C757D;
    --vurgu: #0A118E;
    --vurgu-koyu: #070C66;
    --turuncu: #FF8717;
    --yesil: #2B7D73;
    --koyu: #0A118E;
    --golge: 0 0 0 1px rgba(33, 37, 41, 0.06), 0 1px 2px -1px rgba(33, 37, 41, 0.08), 0 2px 6px 0 rgba(33, 37, 41, 0.04);
    --golge-hover: 0 0 0 1px rgba(10, 17, 142, 0.18), 0 2px 4px -1px rgba(33, 37, 41, 0.10), 0 8px 18px -4px rgba(10, 17, 142, 0.18);
    /* Işık Üniversitesi sitesindeki yazı tipleri: metin Poppins, başlıklar Space Grotesk. */
    --f-govde: "Poppins", system-ui, -apple-system, "Segoe UI", sans-serif;
    --f-baslik: "Space Grotesk", "Poppins", system-ui, sans-serif;
    --f-etiket: "Poppins", system-ui, sans-serif;
    --kap: 1120px;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--zemin);
    color: var(--yazi);
    font: 400 16px/1.6 var(--f-govde);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main { flex: 1 0 auto; position: relative; z-index: 1; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  [hidden] { display: none !important; }
  a, summary, button { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 2px solid var(--vurgu); outline-offset: 3px; border-radius: 4px; }

  .atla { position: absolute; left: -999px; top: 8px; z-index: 30; background: var(--koyu); color: #FFFFFF; padding: 8px 12px; border-radius: 8px; }
  .atla:focus { left: 16px; }

  .kap { width: 100%; max-width: var(--kap); margin-inline: auto; padding-inline: 20px; }
  .etiket { font: 500 12px/1.4 var(--f-etiket); letter-spacing: 0.1em; color: var(--ikincil); margin: 0; text-transform: none; }
  h1, h2, h3 { margin: 0; text-wrap: balance; }
  h1, h2 { font-family: var(--f-baslik); }
  h2 { font-size: clamp(26px, 4vw, 36px); font-weight: 500; line-height: 1.15; letter-spacing: -0.01em; }
  h3 { font-size: 19px; font-weight: 600; line-height: 1.3; }
  p { margin: 0; }
  .ikincil { color: var(--ikincil); }

  /* Üst bar */
  .ust-bar { position: sticky; top: 0; z-index: 20; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--cizgi); }
  .ust-ic { display: flex; align-items: center; gap: 12px; min-height: 64px; }
  .marka { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600; font-size: 15px; white-space: nowrap; margin-right: auto; }
  @media (max-width: 359px) { .marka span { display: none; } }
  @media (min-width: 820px) { .ust-ic { gap: 16px; } .marka { font-size: 17px; } }
  .marka img { width: 40px; height: 40px; }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu-genis { display: none; gap: 4px; }
  .menu-genis a, .menu-mobil a { display: block; text-decoration: none; padding: 8px 12px; border-radius: 8px; color: var(--ikincil); font-weight: 500; }
  .menu-genis a:hover, .menu-mobil a:hover { color: var(--yazi); background: var(--zemin-2); }
  .menu a[aria-current="page"] { color: var(--yazi); }
  .menu-mobil summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-content: center; gap: 6px; border-radius: 10px; border: 1px solid var(--cizgi); }
  .menu-mobil summary::-webkit-details-marker { display: none; }
  .menu-mobil summary span { display: block; width: 18px; height: 2px; background: var(--yazi); border-radius: 2px; }
  .menu-mobil[open] ul { position: absolute; left: 0; right: 0; top: 64px; background: var(--zemin-2); border-bottom: 1px solid var(--cizgi); padding: 8px 20px 16px; }
  .menu-mobil[open] a { padding: 12px 8px; font-size: 17px; }
  .dil { text-decoration: none; font: 500 13px/1 var(--f-etiket); letter-spacing: 0.06em; color: var(--ikincil); border: 1px solid var(--cizgi); border-radius: 999px; padding: 10px 14px; min-height: 40px; display: inline-flex; align-items: center; }
  .dil:hover { color: var(--yazi); border-color: var(--soluk); }
  @media (min-width: 820px) {
    .menu-mobil { display: none; }
    .menu-genis { display: flex; }
  }

  /* Butonlar */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 12px 22px; border-radius: 12px; font: 600 16px/1.2 var(--f-govde); text-decoration: none; border: 1px solid var(--cizgi); background: var(--yuzey); color: var(--yazi); transition: background-color 150ms ease-out, border-color 150ms ease-out, scale 150ms ease-out; }
  .btn:hover { background: var(--yuzey-hover); border-color: rgba(10, 17, 142, 0.35); }
  .btn:active { scale: 0.96; }
  .btn--ana { background: var(--vurgu); color: #FFFFFF; border-color: var(--vurgu-koyu); }
  .btn--ana:hover { background: var(--vurgu-koyu); border-color: var(--vurgu-koyu); }
  @media (prefers-reduced-motion: reduce) { .btn { transition: none; } .btn:active { scale: none; } }

  /* Bölümler */
  .bolum { padding-block: 56px; }
  .bolum-bas { display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; }
  .bolum-bas--satir { flex-direction: row; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; }
  .metin-link { color: var(--vurgu); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(10, 17, 142, 0.35); }
  .metin-link:hover { color: var(--vurgu-koyu); }
  @media (min-width: 820px) { .bolum { padding-block: 80px; } }

  /* Etkinlik kartları */
  .kartlar { display: grid; gap: 14px; grid-template-columns: 1fr; list-style: none; margin: 0; padding: 0; }
  @media (min-width: 720px) { .kartlar { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .kartlar--uc { grid-template-columns: repeat(3, 1fr); } }
  /* Kartın tamamı başlıktaki linke tıklar; kayıt butonu bunun üstünde kalır. */
  .kart { position: relative; display: flex; flex-direction: column; border-radius: 16px; background: var(--kart); box-shadow: var(--golge); min-width: 0; transition: box-shadow 150ms ease-out; }
  .kart:hover { box-shadow: var(--golge-hover); }
  .kart--yaklasan { box-shadow: 0 0 0 2px var(--vurgu), var(--golge); }
  .kart-gorsel { position: relative; aspect-ratio: 4 / 3; background: var(--zemin-2); overflow: hidden; border-radius: 16px 16px 0 0; }
  .kart-gorsel img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale 300ms ease-out; }
  .kart:hover .kart-gorsel img { scale: 1.03; }
  /* Afiş kırpılmaz: kutu afişin kendi oranını alır. */
  .kart-gorsel--afis { aspect-ratio: auto; }
  .kart-gorsel--afis img { position: static; height: auto; }
  /* Yaklaşan etkinlik afişliyse geniş ekranda afiş solda, bilgiler sağda. */
  @media (min-width: 720px) {
    .kart--yan { grid-column: 1 / -1; flex-direction: row; align-items: stretch; }
    .kart--yan .kart-gorsel { flex: 0 0 min(42%, 400px); align-self: start; border-radius: 16px 0 0 16px; }
    .kart--yan .kart-govde { padding: 28px 32px; justify-content: center; }
  }
  .kart-gorsel .kart-logo { inset: 0; margin: auto; width: 96px; height: 96px; object-fit: contain; opacity: 0.6; }
  .kart-govde { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px 22px; flex: 1; }
  .kart-ust { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font: 500 12.5px/1.4 var(--f-etiket); letter-spacing: 0.04em; color: var(--vurgu); }
  .kart-ust span { color: var(--soluk); }
  .kart h3 a { text-decoration: none; }
  .kart h3 a::after { content: ""; position: absolute; inset: 0; }
  .kart:hover h3 a { text-decoration: underline; text-underline-offset: 4px; }
  .kart-ozet { color: var(--ikincil); font-size: 15px; }
  .kart-konuk { font-size: 14px; }
  .kart-alt-bilgi { font-size: 13.5px; color: var(--soluk); }
  .kart-ortak { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 12px; border-top: 1px solid var(--cizgi); }
  .kart-ortak-etiket { font: 500 12px/1 var(--f-etiket); letter-spacing: 0.06em; color: var(--soluk); flex: none; }
  .kart-ortak ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .kart-ortak li { display: flex; }
  .kart-ortak img { width: 40px; height: 40px; border-radius: 10px; object-fit: cover; outline: 1px solid rgba(33, 37, 41, 0.12); outline-offset: -1px; background: #FFFFFF; }
